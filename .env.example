POSTGRESS_URL=postgresql://user:password@localhost:5432/dbname?sslmode=require
RZP_KEY=rzp_test_xxxxxxxxx
RZP_SECRET=xxxxxxxxx
RZP_WEBHOOK_SECRET=xxxxxxxxx
REDIS_URL=redis://localhost:6379/0
GEMINI_API_KEY=

# Messaging Dispatchers (Free Live Mode)
MOCK_DISPATCH=False

# Gmail SMTP (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=u47843212@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password

# CallMeBot (WhatsApp)
CALLMEBOT_PHONE=+918090175358
CALLMEBOT_API_KEY=your_callmebot_api_key

# Telegram Bot (Mobile Alerts/SMS)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Public Base URL for generated links
BASE_URL=http://localhost:8000

# ── Demo / Staging Controls ───────────────────────────────────────────────────
# Set to "true" to show the "Seed Demo Cases" and "Reset All to Pending"
# buttons in the frontend (always visible in NODE_ENV=development).
NEXT_PUBLIC_ENABLE_DEMO_CONTROLS=true

# ── Docker Compose — Redis broker ─────────────────────────────────────────────
# For the local Docker stack, point Celery at the bundled redis container:
#   REDIS_URL=redis://redis:6379/0
# For Upstash (production TLS), use your Upstash rediss:// URL instead:
#   REDIS_URL=rediss://:password@your-upstash-host:6379/0
